# Local configuration for the signature flow. Copy to .env.local and fill in.
# All values are public: they end up in the client bundle. Never put a private
# key or a Hedera account secret here — the page has no backend and signs
# nothing on anyone's behalf.

# mainnet | testnet — which network the page reads signatures from and signs to
VITE_HEDERA_NETWORK=testnet

# The HCS topic that collects signatures. Empty = signing is closed, the page
# shows the "opens at launch" state and reads no messages.
VITE_HCS_TOPIC_ID=

# WalletConnect Cloud project id (public). Required for the wallet handshake.
VITE_WALLETCONNECT_PROJECT_ID=

# Shown in the footer and used to build HashScan links
VITE_CONTACT_URL=
