# Local configuration for the signature flow. Copy to .env.local and fill in.
# All values are public: they end up in the client bundle. Never put a private
# key or a Hedera account secret here — the page has no backend and signs
# nothing on anyone's behalf.

# mainnet | testnet — the project-wide switch: wallet chain, mirror node, HCS
# topic and explorer links all follow it. Defaults to mainnet; anything else
# than the two words fails loudly at load.
VITE_HEDERA_NETWORK=mainnet

# The HCS topic that collects signatures, per network. Empty = signing is closed
# on that network: the page shows the "opens at launch" state and reads nothing.
VITE_HCS_TOPIC_ID_TESTNET=
VITE_HCS_TOPIC_ID_MAINNET=

# WalletConnect Cloud project id (public). Required for the wallet handshake.
VITE_WALLETCONNECT_PROJECT_ID=

# Shown in the footer and used to build HashScan links
VITE_CONTACT_URL=
