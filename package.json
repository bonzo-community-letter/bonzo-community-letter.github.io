{
  "name": "open-letter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page and HCS signature campaign for the Bonzo Lend open letter",
  "scripts": {
    "dev": "vite",
    "dev:tailnet": "bash scripts/dev-tailnet.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "topic:create": "node scripts/create-topic.mjs"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hiero-ledger/proto": "^2.32.1",
    "@hiero-ledger/sdk": "^2.79.0",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.26.0",
    "@walletconnect/types": "^2.26.0",
    "@walletconnect/utils": "^2.26.0",
    "buffer": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
